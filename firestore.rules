rules_version = '2';

// The browser may read the historical shared document for the existing app
// UI. All writes that can create accepted transactions, pending candidates,
// receipts or provider state go through the Firebase-adjacent service, which
// verifies an Admin ID token and household membership before using Admin SDK.
// Admin SDK writes bypass these rules; the service authorization is therefore
// mandatory and is tested in transaction-backend.test.cjs.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function allowedAppUser() {
      return signedIn() && request.auth.token.email in [
        'captainicebow@gmail.com',
        'mgstiles13@gmail.com',
        'zmstiles@gmail.com'
      ];
    }

    // Accepted history remains readable by existing app users. Client writes
    // may update display/settings fields only; transaction array changes stay
    // behind the approval service.
    match /shared/data {
      function existingRevision() {
        return !('revision' in resource.data) ? 0 : resource.data.revision;
      }
      allow read: if allowedAppUser();
      allow create: if allowedAppUser() && request.resource.data.transactions == [] && request.resource.data.revision is int && request.resource.data.revision == 1;
      allow update: if allowedAppUser() && request.resource.data.transactions == resource.data.transactions && existingRevision() is int && existingRevision() >= 0 && request.resource.data.revision is int && request.resource.data.revision >= 0 && request.resource.data.revision == existingRevision() + 1;
      allow delete: if false;
    }

    // Pending inbox, receipts, audit state and provider cursors are service
    // owned. There is deliberately no browser fallback write path.
    match /protectedTransactionReview/{householdId} {
      allow read, write: if false;
    }

    match /protectedAcceptedTransactions/{householdId} {
      allow read, write: if false;
    }

    match /connections/{connectionId} {
      allow read, write: if false;
    }

    match /protectedConnections/{connectionId} {
      allow read, write: if false;
    }

    match /protectedSyncRuns/{runId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
